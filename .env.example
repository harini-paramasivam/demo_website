# Velvora Solutions - Email Integration Environment Configuration
# Use Gmail SMTP with an App Password generated at: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
